{
    "name": "pieceofcake2/imagine",
    "type": "cakephp-plugin",
    "description": "CakePHP 2 plugin for resizing, cropping and creating thumbnails of images with the Imagine library",
    "keywords": ["cakephp", "cakephp2", "media", "image", "image-processing"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "composer/installers": "^1.0 || ^2.0",
        "imagine/imagine": "^1.5",
        "pieceofcake2/cakephp": "^2.12"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.2",
        "pieceofcake2/phpcs-cakephp2": "^1.0",
        "pieceofcake2/phpstan-cakephp2": "^0.2.3"
    },
    "suggest": {
        "ext-gd": "For GD-based image processing",
        "ext-imagick": "For Imagick-based image processing"
    },
    "replace": {
        "burzum/cakephp-imagine-plugin": "^1.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Imagine"
    }
}
